---
import '../styles/global.css';
import {getStore} from '../data/providers';
import {url,imageUrl} from '../lib/format';
const {title='Belts with character. Made for your everyday.',description='Discover formal, casual, wedding and everyday belts at Beltaly. Thoughtful details. Indian prices. Find your perfect fit.',image='/products/hero.svg',noindex=false}=Astro.props;
const {settings}=await getStore();
const canonical=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="theme-color" content={settings.colours.espresso}/><title>{title} | {settings.name}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>{noindex&&<meta name="robots" content="noindex,follow"/>}<meta property="og:title" content={`${title} | ${settings.name}`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(url(image),Astro.site)}/><meta name="twitter:card" content="summary_large_image"/><link rel="icon" href={url('/favicon.svg')} type="image/svg+xml"/><style define:vars={{themeLeather:settings.colours.leather,themeCream:settings.colours.cream,themeEspresso:settings.colours.espresso,themeBrass:settings.colours.brass}} is:global>:root{--leather:var(--themeLeather);--cream:var(--themeCream);--espresso:var(--themeEspresso);--brass:var(--themeBrass)}</style></head><body>
<a class="skip" href="#main">Skip to content</a><div class="announcement">{settings.announcement}</div>
<header class="wrap header"><a class="logo" href={url('/')} aria-label="Beltaly home"><span class="buckle" aria-hidden="true"></span>{settings.logo?<img src={imageUrl(settings.logo)} alt={settings.name} width="120" height="40"/>:settings.name}<span style="font-size:12px;align-self:start;letter-spacing:0">®</span></a><nav aria-label="Main"><a href={url('/shop/')} data-i18n="shop">Shop</a><a href={url('/shop/?category=ethnic')}>The occasion edit</a><a href={url('/size-guide/')} data-i18n="guide">Size guide</a><a href={url('/about/')} data-i18n="story">Our story</a></nav><div class="actions"><button class="plain" id="language" aria-label="Switch language">हिं / EN</button><a href={url('/search/')} aria-label="Search">⌕</a><a href={url('/cart/')} aria-label="Shopping bag">Bag (<span data-cart-count>0</span>)</a></div></header>
<main id="main"><slot/></main>
<section class="community"><div class="eyebrow">THE BELTALY CIRCLE</div><h2 data-i18n="community">Let’s stay in the loop.</h2><p data-i18n="communityBody">New collections, styling notes, and a little inspiration. Find us where the conversations happen.</p><div class="button-row" style="justify-content:center"><a class="btn secondary" href={settings.whatsapp?`https://wa.me/${settings.whatsapp}`:url('/contact/')} data-i18n="whatsapp">Chat on WhatsApp ↗</a>{settings.instagram&&<a class="text-link" href={settings.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a>}</div></section>
<footer class="wrap"><div class="footer"><div><a class="logo" href={url('/')}><span class="buckle"></span>{settings.name}</a><p data-i18n="footer">Thoughtful belts. Everyday character.</p><small>DESIGNED FOR MODERN INDIA</small></div><div><h3>Explore</h3><a href={url('/shop/')} data-i18n="shop">Shop all</a><a href={url('/size-guide/')} data-i18n="guide">Size guide</a><a href={url('/about/')} data-i18n="about">About Beltaly</a></div><div><h3>Here to help</h3><a href={url('/contact/')} data-i18n="contact">Contact</a><a href={url('/faq/')} data-i18n="faq">FAQs</a><a href={url('/shipping/')} data-i18n="shipping">Shipping & returns</a></div><div><h3>The fine print</h3><a href={url('/privacy/')} data-i18n="privacy">Privacy</a><a href={url('/terms/')} data-i18n="terms">Terms</a><p class="hint">{settings.gstin?`GSTIN: ${settings.gstin}`:'GSTIN: owner setup pending'}</p></div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} {settings.name}. A little detail goes a long way.</span><span>₹ INR · Made for India</span></div></footer>
<div class="sample-note" data-i18n="sample">Preview store · Sample products and policies. Ordering opens after owner setup.</div><a class="whatsapp" href={settings.whatsapp?`https://wa.me/${settings.whatsapp}`:url('/contact/')} aria-label="Contact via WhatsApp">↗ Let’s talk</a>
<nav class="bottom-nav" aria-label="Mobile"><a href={url('/')}><span>⌂</span><b data-i18n="home">Home</b></a><a href={url('/shop/')}><span>▤</span><b data-i18n="shop">Shop</b></a><a href={url('/search/')}><span>⌕</span><b data-i18n="search">Search</b></a><a href={url('/cart/')}><span>♧</span><b data-i18n="cart">Cart</b></a><a href={url('/account/')}><span>○</span><b data-i18n="account">Account</b></a></nav>
<div id="toast" class="toast" role="status" hidden></div><script id="store-data" type="application/json" set:html={JSON.stringify({settings,base:import.meta.env.BASE_URL}).replace(/</g,'\\u003c')}></script><script>import '../scripts/app';</script>
</body></html>

