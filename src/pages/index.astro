---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import {getStore} from '../data/providers';
import {url} from '../lib/format';
const {products,categories,collections,banners,settings}=await getStore();
const featured=collections.find(c=>c.id==='bestsellers');
---
<Layout><div class="wrap"><section class="hero"><div class="hero-copy"><p class="eyebrow" data-i18n="heroEyebrow">CRAFTED FOR THE EVERYDAY</p><h1><span data-i18n="heroTitle">A small detail.</span><br/><em data-i18n="heroEmphasis">A lasting<br/> impression.</em></h1><p data-i18n="heroBody">From your first meeting to your last-minute plans. Belts with character, made to bring it all together.</p><div class="button-row"><a class="btn" href={url('/shop/')}><span data-i18n="collection">Explore the collection</span><span>↗</span></a><a class="text-link" href={url('/about/')} data-i18n="story">Our story</a></div><div class="tiny-note">CONSIDERED DETAILS. &nbsp; HONEST CHARACTER. &nbsp; EVERYDAY EASE.</div></div><div class="hero-art"><img src={url('/products/hero.svg')} alt="Studio illustration of a tan leather belt with brass buckle" width="900" height="900" fetchpriority="high"/><div class="circle-seal">Small details.<br/>Big character.<br/>✳</div><div class="art-caption"><span>THE EVERYDAY EDIT — 01</span><span>BELTALY STUDIO</span></div></div></section><div class="trust"><span data-i18n="trustCod">COD on eligible orders</span><span data-i18n="trustReturns">Easy returns · see policy</span><span data-i18n="trustSecure">Pay with your UPI app</span></div>
<section class="section"><div class="section-head"><div><p class="eyebrow" data-i18n="categoryEyebrow">A FIT FOR EVERY OCCASION</p><h2 data-i18n="categories">Find your kind of everyday.</h2></div></div><div class="category-grid">{categories.map((c,i)=><a class="category" href={url(`/shop/?category=${c.id}`)}><span aria-hidden="true">{['▱','≈','✳','⇄','⌁','⊞'][i]}</span><b>{c.name} <span style="float:right;font-size:16px">↗</span></b></a>)}</div></section>
<section class="section" style="padding-top:10px"><div class="section-head"><div><p class="eyebrow" data-i18n="favouritesEyebrow">GOOD TASTE. GREAT COMPANY.</p><h2 data-i18n="favourites">The everyday favourites.</h2></div><a class="text-link" href={url('/shop/')} data-i18n="viewAll">View all belts ↗</a></div><div class="products home-products">{(featured?featured.productIds.map(id=>products.find(p=>p.id===id)!):products.slice(0,4)).map(p=><ProductCard product={p} cloud={settings.cloudinaryCloud}/>)}</div></section>
{banners.filter(b=>b.enabled).map(b=><section class="strip"><div><p class="eyebrow">{b.eyebrow}</p><h2>{b.title}</h2><p>{b.description}</p></div><div><div style="font-size:65px;color:var(--brass);margin-bottom:15px" aria-hidden="true">✳ ─── ✳</div><a class="btn" href={url(b.href)}>Discover the edit <span>↗</span></a></div></section>)}
<section class="section editorial"><div class="editorial-art"><img src={url('/products/detail-0.svg')} alt="Belt sizing studio illustration" width="900" height="900" loading="lazy"/></div><div><p class="eyebrow">A LITTLE GUIDE TO A GREAT FIT</p><h2 data-i18n="sizeTitle">The right fit changes everything.</h2><p data-i18n="sizeBody">No guesswork. Just a tape measure and a minute. Find the belt that feels like it was made for you.</p><a class="text-link" href={url('/size-guide/')} data-i18n="sizeCta">Find your belt size ↗</a><div class="steps" aria-hidden="true">{Array.from({length:5},()=><span class="hole"></span>)}</div></div></section>
<section class="section" style="padding-top:0"><p class="eyebrow">THE FEELING WE’RE MAKING ROOM FOR</p><h2>Made to fit your life.</h2><p class="hint">Illustrative customer stories — real reviews will appear after launch.</p><div class="quotes">{[['The everyday upgrade','A considered finish for office mornings, coffee runs, and everything in between.','01 / WORKDAY'],['A gift with character','Something useful. Something personal. Something they will reach for again.','02 / GIFTING'],['One less thing to think about','A good fit brings the whole outfit together. Simple as that.','03 / EVERYDAY']].map(([title,quote,note])=><div class="quote"><small>{title}</small><blockquote>“{quote}”</blockquote><small>{note}</small></div>)}</div></section><section class="section" style="border-top:1px dashed var(--line)"><p class="eyebrow">THE NEXT CHAPTER</p><h2>Belts today.<br/>Wallets on the horizon.</h2><p>Beltaly is a belt and leather goods company. Our upcoming wallet collection will bring the same considered details to what you carry every day.</p><span class="badge" style="position:static">WALLETS · COMING SOON</span></section></div></Layout>
