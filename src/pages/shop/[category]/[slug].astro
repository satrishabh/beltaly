---
import Layout from '../../../layouts/Layout.astro';import ProductCard from '../../../components/ProductCard.astro';import {getStore} from '../../../data/providers';import {money,url,imageUrl,productUrl} from '../../../lib/format';
export async function getStaticPaths(){const {products}=await getStore();return products.map(product=>({params:{category:product.category,slug:product.slug},props:{product}}));}
const {product:p}=Astro.props;const {products,settings}=await getStore();
const schema={'@context':'https://schema.org','@type':'Product',name:p.name,description:p.description,image:p.images.map(i=>new URL(imageUrl(i,settings.cloudinaryCloud),Astro.site).href),sku:p.id,brand:{'@type':'Brand',name:settings.name},offers:{'@type':'Offer',price:p.price,priceCurrency:'INR',availability:`https://schema.org/${p.stock?'InStock':'OutOfStock'}`,url:new URL(productUrl(p),Astro.site).href}};
---
<Layout title={p.name} description={p.description} image={p.images[0]}><div class="wrap section"><div class="breadcrumb"><a href={url('/')}>Home</a> / <a href={url('/shop/')}>Shop</a> / {p.name}</div><div class="detail"><div><button class="plain" style="padding:0;width:100%" id="zoom-open" aria-label="Zoom product image"><img class="main-image" id="main-product-image" src={imageUrl(p.images[0],settings.cloudinaryCloud)} alt={`${p.name} in ${p.colour}`} width="900" height="900" fetchpriority="high"/></button><div class="gallery-thumbs">{p.images.map((image,i)=><button data-gallery={imageUrl(image,settings.cloudinaryCloud)} aria-label={`View ${i+1}`}><img src={imageUrl(image,settings.cloudinaryCloud)} alt={`${p.name}, view ${i+1}`} width="80" height="80"/></button>)}</div></div><div><p class="eyebrow">{p.material} / {p.width} MM / {p.buckle}</p><h1>{p.name}</h1><div class="detail-price">{money(p.price)} <del>{money(p.mrp)}</del> <span class="badge" style="position:static">{Math.round((1-p.price/p.mrp)*100)}% OFF</span></div><p class="hint" data-i18n="tax">Inclusive of all taxes</p><p>{p.description}</p><p class="stock">{p.stock?'● Available in this sample catalogue':'Currently out of stock'}</p><form id="add-form" data-id={p.id}><label><span data-i18n="size">Size</span><select name="size" required>{p.sizes.map(size=><option value={size}>{size} in / {Math.round(size*2.54)} cm</option>)}</select></label><label><span data-i18n="colour">Colour</span><select name="colour"><option>{p.colour}</option></select></label><p class="hint"><a class="text-link" href={url('/size-guide/')}>Not sure? Find your belt size ↗</a></p><button class="btn mobile-add" type="submit" disabled={!p.stock}><span data-i18n="add">Add to bag</span><span>＋</span></button></form><a class="text-link" href={settings.whatsapp?`https://wa.me/${settings.whatsapp}?text=${encodeURIComponent(`Hi! I'd like to know more about ${p.name} (${p.id}).`)}`:url('/contact/')}>Ask about this belt on WhatsApp ↗</a><div style="margin-top:28px"><label for="pincode" data-i18n="delivery">Check delivery</label><div class="inline-form"><input id="pincode" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="6-digit pincode"/><button id="check-pincode" class="btn secondary" data-i18n="check">Check</button></div><p id="delivery-result" class="hint" role="status"></p></div><details><summary>Material & care</summary><p>{p.care}</p></details><details><summary>Shipping & returns</summary><p>Shipping is {money(settings.shippingFee)}; free on orders of {money(settings.freeShippingAbove)} or more. <a class="text-link" href={url('/shipping/')}>Read the sample policy</a>.</p></details><details><summary>Quick size calculator</summary><label>Waist (inches) <input id="waist-inline" type="number" min="18" max="60"/></label><p class="hint" id="size-inline" role="status">Usually choose a belt 2 inches larger than your waist; check available sizes.</p></details></div></div><section class="section"><h2>A little more your style.</h2><div class="products">{products.filter(v=>v.id!==p.id&&v.category===p.category).slice(0,4).map(v=><ProductCard product={v} cloud={settings.cloudinaryCloud}/>)}</div></section></div><dialog id="zoom-dialog"><form method="dialog"><button class="btn secondary">Close ×</button></form><img id="zoom-image" src={imageUrl(p.images[0],settings.cloudinaryCloud)} alt={`${p.name}, enlarged`} width="900" height="900"/></dialog><script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}></script></Layout>
