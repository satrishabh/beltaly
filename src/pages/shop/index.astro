---
import Layout from '../../layouts/Layout.astro';import ProductCard from '../../components/ProductCard.astro';import {getStore} from '../../data/providers';
const {products,categories,settings}=await getStore();
const fields=[['material','Material',[...new Set(products.map(p=>p.material))]],['colour','Colour',[...new Set(products.map(p=>p.colour))]],['width','Width (mm)',[...new Set(products.map(p=>String(p.width)))]],['buckle','Buckle',[...new Set(products.map(p=>p.buckle))]]] as const;
---
<Layout title="Shop belts"><div class="wrap"><header class="page-head"><p class="eyebrow">THE BELTALY COLLECTION</p><h1>A good fit starts here.</h1><p>Thoughtful details for every day, and the days that call for a little more.</p></header><div class="shop-layout section" style="padding-top:0"><form class="filters" id="filters"><label>Category<select name="category"><option value="">All categories</option>{categories.map(c=><option value={c.id}>{c.name}</option>)}</select></label>{fields.map(([name,label,values])=><label>{label}<select name={name}><option value="">All</option>{values.map(v=><option value={v}>{v}</option>)}</select></label>)}<label>Maximum price (₹)<input type="number" name="max" min="0" placeholder="Any price"/></label><button class="btn secondary" type="reset">Clear filters</button></form><div><div class="listing-top"><span id="result-count" role="status">{products.length} considered essentials</span><label>Sort <select id="sort" aria-label="Sort products"><option value="featured">Featured</option><option value="price-asc">Price: low to high</option><option value="price-desc">Price: high to low</option><option value="name">Name: A–Z</option></select></label></div><div class="products shop-products" id="catalogue">{products.map(p=><ProductCard product={p} cloud={settings.cloudinaryCloud}/>)}</div><p id="no-results" class="empty" hidden>No belts match those filters. Try a different combination.</p></div></div></div></Layout>
