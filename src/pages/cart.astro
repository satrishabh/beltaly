---
import Layout from '../layouts/Layout.astro';import {getStore} from '../data/providers';
const {settings}=await getStore();
const paymentLabels:Record<string,string>={whatsapp:'Order on WhatsApp',upi:'Pay with UPI',paymentLink:'Open payment link',cod:'Cash on Delivery (confirm on WhatsApp)'};
---
<Layout title="Your bag" noindex><div class="wrap section"><p class="eyebrow">A FEW GOOD CHOICES</p><h1 style="font-size:3.8rem">Your bag.</h1><div class="cart-layout"><div id="cart-items" aria-live="polite"></div><div><div class="summary-box"><h3>The details</h3><div class="total-row"><span>Subtotal</span><span id="subtotal">₹0</span></div><div class="total-row"><span>Shipping</span><span id="shipping">₹0</span></div><div class="total-row"><span>COD charge</span><span id="cod-fee">₹0</span></div><hr/><div class="total-row"><b>Total</b><b id="total">₹0</b></div><p class="hint">Inclusive of all taxes. Shipping and COD charges included as shown.</p></div><form id="checkout-form" class="checkout"><h3 data-i18n="checkout">Checkout</h3><div class="form-grid"><label>Name<input name="name" autocomplete="name" required maxlength="100"/></label><label>Mobile number<input name="phone" type="tel" inputmode="numeric" autocomplete="tel-national" pattern="[0-9]{10}" required placeholder="10 digits"/></label><label class="full">Delivery address<textarea name="address" autocomplete="street-address" required rows="3" maxlength="600"></textarea></label><label>Pincode<input name="pincode" autocomplete="postal-code" inputmode="numeric" pattern="[0-9]{6}" required maxlength="6"/></label></div><fieldset><legend>How would you like to order?</legend>{Object.entries(settings.methods).filter(([,enabled])=>enabled).map(([key],i)=><label><input type="radio" name="method" value={key} checked={i===0} required/> {paymentLabels[key]}</label>)}</fieldset><p class="hint">This static store prepares an order request. Stock, payment and acceptance are confirmed by the owner. Your address stays in this page until you choose to send it.</p><button class="btn" type="submit">Prepare order ↗</button><p id="checkout-error" class="error" role="alert"></p></form><div id="order-result" role="status" hidden></div></div></div></div></Layout>
